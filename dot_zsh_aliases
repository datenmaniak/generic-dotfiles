# --- listado global de aliases ---
aliases() {
    local desc="Listado general de los aliases"    
    echo "\033[1;35m========================================\033[0m"
    echo "\033[1;35m       TODOS LOS ALIAS DEL SISTEMA      \033[0m"
    echo "\033[1;35m========================================\033[0m\n"

    # Asegura la lectura del archivo por si acaso
    [[ -f ~/.zsh_aliases ]] && source ~/.zsh_aliases

    local fn
    for fn in ${(ok)functions}; do
        # Filtra para que:
        # 1. Termine en 'help' o 'alias'
        # 2. No sea la función principal 'aliases'
        # 3. NO empiece con '_' (lo que descarta las funciones internas de autocompletado)
         if [[ ($fn == *help ) && $fn != "aliases" && $fn != _* ]]; then
         #if [[ ($fn == *help || $fn == *alias) && $fn != "aliases" && $fn != _* ]]; then
            $fn
        fi
    done
}

funalias() {
    echo "\033[1;34m--- Listado de alias y descripción ---\033[0m"
    #local desc="Listar las ayuda global de aliases y su descripción"    
    [[ -f ~/.zsh_aliases ]] && source ~/.zsh_aliases

    zmodload -i zsh/parameter   # asegura $functions disponible

    local fn desc
    for fn in ${(ok)functions}; do
        if [[ ($fn == *help || $fn == *alias) && $fn != "aliases" && $fn != _* ]]; then

            # Extrae la línea 'local desc="..."' del cuerpo de la función
            desc=$(print -r -- "${functions[$fn]}" \
                   | grep -m1 -E 'local[[:space:]]+desc=' \
                   | sed -E 's/.*local[[:space:]]+desc="([^"]*)".*/\1/')

            [[ -z "$desc" ]] && desc="Sin descripción"

            printf "  \033[1;32m%-10s\033[0m : %s\n" "$fn" "$desc"
        fi
    done
    echo ""
}



    plog    "podman logs -f"
    prun    "podman run -it --rm"
    prund   "podman run -d"
    pca     "podman ps -a"
    pcr     "podman ps"
    psu     "podman system prune -f"
    pimg    "podman images"
    ppull   "podman pull"
    pprune  "podman image prune -f"
    pirm    "podman image rm -f"
    pbuild  "podman build"
    pstart  "podman start -i"
    pstop   "podman stop"
    prest   "podman restart"
    prmf    "podman rm -f"
    pport   "podman port"
    pvol    "podman volume ls"
    pnet    "podman network ls"
    pneti   "podman network inspect"
    pinfo   "podman system info"
    pcupd   "podman-compose up -d"
    pdown   "podman-compose down"
    pdownv  "podman-compose down -v"
